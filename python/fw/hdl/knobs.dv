# yaml-language-server: $schema=https://dv-flow.github.io/flow.dv.schema.json
package:
  name: fw.hdl.knobs
  desc: Knob files -- one source, many schedules
  doc: |
    A knob file decides what the source does not: where registers go, how deep
    buffers are, each block's schedule, and how storage is bound. See the
    knob-file reference for every key.

  tasks:
  - name: Resolve
    scope: export
    desc: Merge a knob file through its bases, check it, and write the resolved knobs
    doc: |
      Consumes one `fwKnobFile` fileset holding exactly one YAML knob file.
      Merges its `base:` chain (dicts merge, lists and scalars replace, later
      wins) and checks the result against the knob schema; an error names the
      file and line to change.

      Outputs:

      * `fwKnobs` -- `<top>.knobs.json`, the merged knobs. Per-block codegen and
        Integrate read this.
      * `systemVerilogSource` -- `<top>_knobs_pkg.sv`, one localparam per
        `rtl:` entry, for sources and testbenches that size themselves from the
        knobs.
      * `xlsCodegenOptions` -- `<top>.codegen.json`, each `design.xls` block's
        schedule and registering, keyed by module. `synth.xls.Codegen` reads
        it, so one Codegen task builds every block with its own options.
    consumes:
    - filetype: fwKnobFile
    passthrough: none
    shell: pytask
    run: fw.hdl.dfm_tasks.KnobsResolve
