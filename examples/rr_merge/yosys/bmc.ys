# Bounded equivalence of the generated rr_merge and the reference
# (yosys/rr_merge_miter.sv) at N = @N@, DEPTH = @DEPTH@: from all-zero registers,
# reset in the first cycle, then free inputs (reset included) for 40 cycles.
# scripts/compare.sh fills in @N@/@DEPTH@ and writes the sv2v output read here.
read_verilog rundir/compare/rr_merge_ref.v
read_verilog rundir/compare/rr_merge_gen.v
read_verilog -sv -formal yosys/rr_merge_miter.sv
chparam -set N @N@ -set DEPTH @DEPTH@ rr_merge_miter
prep -top rr_merge_miter
chformal -lower
memory
flatten
opt -fast
sat -verify -prove-asserts -set-init-zero -set-at 1 reset 1 -seq 40 -timeout 600
